# Local development template for Foresight OS.
# Copy this file to .env and fill in only the providers you intend to use.
# Never commit .env or place production credentials in this file.

# First-class web search provider.
FORESIGHT_WEB_SEARCH_PROVIDER=json-post
FORESIGHT_WEB_SEARCH_URL=
FORESIGHT_WEB_SEARCH_TOKEN=

# SearXNG options when FORESIGHT_WEB_SEARCH_PROVIDER=searxng.
FORESIGHT_SEARXNG_CATEGORIES=general
FORESIGHT_SEARXNG_LANGUAGE=

# MAF-agent hosted signal providers.
GITHUB_MCP_TOKEN=
ALPHAVANTAGE_API_KEY=
FRED_MCP_TOKEN=

# Optional provider endpoint overrides for local mirrors or test fixtures.
FORESIGHT_GITHUB_MCP_URL=
FORESIGHT_ALPHA_VANTAGE_MCP_URL=
FORESIGHT_FRED_MCP_URL=

# FRED must expose one explicitly approved read-only operation.
FRED_MCP_READ_TOOL=
FRED_MCP_READ_ARGS_JSON={}

# Local probe-only switch. Keep disabled for production verification.
FORESIGHT_ALLOW_ALPHA_DEMO=0

# Probe inputs for configured external boundaries.
FORESIGHT_REAL_WEB_QUERY=
FORESIGHT_REAL_MCP_URL=
FORESIGHT_REAL_MCP_TOKEN=
FORESIGHT_REAL_MCP_QUERY=
