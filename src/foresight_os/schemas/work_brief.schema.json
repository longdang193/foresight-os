{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresight-os.local/schemas/work-brief.schema.json",
  "title": "Foresight OS Work Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "investigation_id",
    "decision_question",
    "scope",
    "desired_deliverables",
    "assumptions",
    "open_dependencies",
    "current_direction",
    "next_useful_step"
  ],
  "properties": {
    "investigation_id": { "type": "string", "minLength": 1 },
    "decision_question": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" } },
    "desired_deliverables": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_dependencies": { "type": "array", "items": { "type": "string" } },
    "current_direction": { "type": "string" },
    "next_useful_step": { "type": "string" },
    "horizon": { "type": "string" },
    "consequence_level": { "type": "string" },
    "user_preferences": { "type": "object", "additionalProperties": true },
    "analysis_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "required_tables": { "type": "array", "items": { "type": "string" } },
          "column_mappings": { "type": "object", "additionalProperties": { "type": "string" } },
          "entity_scope": { "type": "array", "items": { "type": "string" } },
          "periods": { "type": "array", "items": { "type": "string" } },
          "baseline_period": { "type": ["string", "null"] },
          "comparison_period": { "type": ["string", "null"] },
          "scenarios": { "type": "array", "items": { "type": "string" } },
          "units": { "type": "string" },
          "reporting_currency": { "type": "string" },
          "conversion_rates": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
          "duplicate_policy": { "type": "string", "enum": ["flag_and_exclude", "keep_first", "reject"] },
          "missing_value_policy": { "type": "string", "enum": ["preserve_as_issue", "exclude", "reject"] },
          "required_calculations": { "type": "array", "items": { "type": "string" } },
          "required_validation_checks": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "compatibility_assumption": { "type": "string" }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "contract_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "execution_intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_patterns": { "type": "array", "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } },
        "preferred_patterns": { "type": "array", "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } },
        "required_participants": { "type": "array", "items": { "type": "string" } },
        "preferred_participants": { "type": "array", "items": { "type": "string" } },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "preferred_capabilities": { "type": "array", "items": { "type": "string" } },
        "preferred_reasoning_controls": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number", "boolean"] } },
        "source": { "type": "string" }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "objective"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "participants": { "type": "array", "items": { "type": "string" } },
          "subtasks": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "expected_result": { "type": "string" },
          "skill_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "execution_intent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required_patterns": { "type": "array", "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } },
              "preferred_patterns": { "type": "array", "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } },
              "required_participants": { "type": "array", "items": { "type": "string" } },
              "preferred_participants": { "type": "array", "items": { "type": "string" } },
              "required_capabilities": { "type": "array", "items": { "type": "string" } },
              "preferred_capabilities": { "type": "array", "items": { "type": "string" } },
              "preferred_reasoning_controls": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number", "boolean"] } },
              "source": { "type": "string" }
            }
          },
          "limits": { "type": "object", "additionalProperties": { "type": ["integer", "string"] } },
          "research_needs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "query"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "query": { "type": "string", "minLength": 1 },
                "source_hint": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
