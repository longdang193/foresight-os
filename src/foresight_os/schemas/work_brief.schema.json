{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresight-os.local/schemas/work-brief.schema.json",
  "title": "Foresight OS Work Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "investigation_id",
    "decision_question",
    "scope",
    "desired_deliverables",
    "assumptions",
    "open_dependencies",
    "current_direction",
    "next_useful_step"
  ],
  "properties": {
    "investigation_id": { "type": "string", "minLength": 1 },
    "decision_question": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" } },
    "desired_deliverables": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_dependencies": { "type": "array", "items": { "type": "string" } },
    "current_direction": { "type": "string" },
    "next_useful_step": { "type": "string" },
    "execution_pattern_override": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] },
        { "type": "array", "maxItems": 4, "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "objective"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "participants": { "type": "array", "items": { "type": "string" } },
          "subtasks": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "expected_result": { "type": "string" },
          "skill_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "execution_pattern_override": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] },
              { "type": "array", "maxItems": 4, "items": { "type": "string", "enum": ["direct", "sequential", "concurrent", "handoff", "group_chat"] } }
            ]
          },
          "limits": { "type": "object", "additionalProperties": { "type": ["integer", "string"] } },
          "research_needs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "query"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "query": { "type": "string", "minLength": 1 },
                "source_hint": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
