{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresight-os.local/schemas/approval-record.schema.json",
  "title": "Foresight OS Execution Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["investigation_id", "status", "projection", "projection_fingerprint", "displayed_fingerprint", "recipe_snapshot_fingerprint", "approval_source", "approved_at", "approver_label", "supersedes_fingerprint", "run_decisions"],
  "properties": {
    "investigation_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["APPROVED", "REJECTED", "SUPERSEDED"] },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "recipe", "adaptation_envelope"],
      "properties": {
        "brief": { "type": "object" },
        "recipe": { "type": "object" },
        "adaptation_envelope": { "type": "object" }
      }
    },
    "projection_fingerprint": { "type": "string", "minLength": 1 },
    "displayed_fingerprint": { "type": "string", "minLength": 1 },
    "recipe_snapshot_fingerprint": { "type": "string", "minLength": 1 },
    "approval_source": { "type": "string", "const": "local_cli" },
    "approved_at": { "type": "string", "minLength": 1 },
    "approver_label": { "type": ["string", "null"] },
    "supersedes_fingerprint": { "type": ["string", "null"] }
    ,"run_decisions": { "type": "object" }
  }
}
