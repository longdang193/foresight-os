{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresight-os.local/schemas/analysis.schema.json",
  "title": "Foresight OS Analysis State",
  "type": "object",
  "additionalProperties": false,
  "required": ["investigation_id", "revision", "schema_version", "revision_status", "evidence", "calculations", "claims", "implications", "recommendations", "artifacts", "relationships", "revisions", "invalidation", "review_records"],
  "properties": {
    "investigation_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "schema_version": { "type": "integer", "const": 1 },
    "revision_status": { "enum": ["DRAFT", "PENDING_REVIEW", "ACCEPTED", "REJECTED", "SUPERSEDED"] },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "calculations": { "type": "array", "items": { "$ref": "#/$defs/calculation" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/analytical_record" } },
    "implications": { "type": "array", "items": { "$ref": "#/$defs/analytical_record" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/$defs/analytical_record" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "revisions": { "type": "array", "items": { "$ref": "#/$defs/revision" } },
    "invalidation": { "$ref": "#/$defs/invalidation" },
    "review_records": { "type": "array", "items": { "$ref": "#/$defs/review_record" } },
    "pending_token": { "type": ["string", "null"] }
  },
  "$defs": {
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_version", "sheet", "range", "units", "transformation", "calculation"],
      "properties": {
        "file_version": { "type": "string", "minLength": 1 },
        "sheet": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "units": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "minLength": 1 },
        "calculation": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_locator", "version", "date", "excerpt", "limitations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_locator": { "$ref": "#/$defs/source_locator" },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "measurement_key": { "anyOf": [{ "$ref": "#/$defs/measurement_key" }, { "type": "null" }] }
      }
    },
    "measurement_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "measure", "period", "units", "scenario", "version"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "measure": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "units": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "formula", "input_ids", "output", "units", "source_locators"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "$ref": "#/$defs/measurement_key" },
        "formula": { "type": "string", "minLength": 1 },
        "input_ids": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "number" },
        "units": { "type": "string", "minLength": 1 },
        "source_locators": { "type": "array", "items": { "type": "string" } }
      }
    },
    "analytical_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "basis", "assessment", "lifecycle", "evidence_ids", "relationship_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["OBSERVED", "DERIVED", "ASSUMED"] },
        "assessment": { "enum": ["UNASSESSED", "SUPPORTED", "UNCERTAIN", "CONTESTED", "REFUTED"] },
        "lifecycle": { "enum": ["CURRENT", "SUPERSEDED"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "relationship_ids": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "array", "items": { "type": "string" } },
        "confidence_rationale": { "type": "string" },
        "disconfirmation_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "target_ids", "reviewed_state_revision", "input_fingerprint", "skill_ids", "skill_versions", "objections", "outcome", "limitations", "unresolved_issues"],
      "properties": {
        "review_id": { "type": "string", "minLength": 1 },
        "target_ids": { "type": "array", "items": { "type": "string" } },
        "reviewed_state_revision": { "type": "integer", "minimum": 1 },
        "input_fingerprint": { "type": "string", "minLength": 1 },
        "skill_ids": { "type": "array", "items": { "type": "string" } },
        "skill_versions": { "type": "array", "items": { "type": "string" } },
        "objections": { "type": "array", "items": { "type": "object" } },
        "outcome": { "enum": ["ACCEPTED", "PROVISIONAL", "REJECTED"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "unresolved_issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "lifecycle", "relationship_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["CURRENT", "SUPERSEDED"] },
        "relationship_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_id", "to_id", "relation_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from_id": { "type": "string", "minLength": 1 },
        "to_id": { "type": "string", "minLength": 1 },
        "relation_type": { "type": "string", "minLength": 1 }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "change_reason", "record_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "change_reason": { "type": "string", "minLength": 1 },
        "record_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stale_artifact_ids", "reassessment_ids", "reasons"],
      "properties": {
        "stale_artifact_ids": { "type": "array", "items": { "type": "string" } },
        "reassessment_ids": { "type": "array", "items": { "type": "string" } },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
